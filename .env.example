# Port & Runtime configuration
PORT=3000
NODE_ENV=production

# Firebase Project & Database
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Firebase Admin SDK credentials
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CORS Origin policy (comma-separated origins or * for development)
CORS_ORIGIN=*

# Logging configuration (info, warn, error, debug)
LOG_LEVEL=info

# WhatsApp Gateway Environment
WHATSAPP_ENVIRONMENT=production
WHATSAPP_LOG_LEVEL=silent

# GEMINI_API_KEY: Optional key for workout & diet generation assistant
GEMINI_API_KEY=
