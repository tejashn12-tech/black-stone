rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection: user profiles, roles, and gym associations
    match /users/{userId} {
      allow read, write: if true;
    }

    // Packages collection: Anyone can read active membership plans; writes require admin/staff
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true; // Allow initial seeding & gym staff management
    }

    // Trainers collection: Anyone can view trainers; writes require admin/staff
    match /trainers/{trainerId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection: General gym info is readable by all; updates by admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Enquiries: Anyone can submit a trial/contact enquiry; read/update by gym manager
    match /enquiries/{enquiryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Members collection
    match /members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    // WhatsApp logs collection
    match /whatsappLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // WhatsApp Idempotency & Concurrency Locks
    match /whatsappIdempotency/{key} {
      allow read: if true;
      allow write: if true;
    }

    // DPDP Consent Records: Anyone can log consent when submitting forms; audit read/write
    match /consentRecords/{consentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // DPDP Data Principal Rights Requests (DSR)
    match /dataSubjectRequests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Festival Calendar
    match /festivalCalendar/{festivalId} {
      allow read: if true;
      allow write: if true;
    }

    // Server-only private auth credentials: deny all client access
    match /_private_server_auth/{document=**} {
      allow read, write: if false;
    }

    // Multi-tenant Gyms collection & subcollections
    match /gyms/{gymId} {
      allow read, write: if true;

      match /whatsapp/{docId} {
        allow read, write: if true;
      }

      // WhatsApp session credentials strictly prohibited from client access
      match /whatsappSessions/{sessionId} {
        allow read, write: if false;
      }

      match /automations/{automationId} {
        allow read, write: if true;
      }

      match /automations_sent/{key} {
        allow read, write: if true;
      }

      match /whatsappMessages/{messageId} {
        allow read, write: if true;
      }

      match /members/{memberId} {
        allow read, write: if true;
      }

      match /payments/{paymentId} {
        allow read, write: if true;
      }

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
  }
}
